{
	"name": "@zandovi/n8n-nodes-zandovi",
	"version": "0.1.0",
	"description": "n8n node for Zandovi: render image templates with variables, upload images and run batch jobs.",
	"license": "MIT",
	"homepage": "https://docs.zandovi.com/integrations/n8n/",
	"keywords": [
		"n8n-community-node-package",
		"zandovi",
		"image generation",
		"templates"
	],
	"author": {
		"name": "Zandovi",
		"email": "support@zandovi.com",
		"url": "https://zandovi.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/zandovi/n8n-nodes-zandovi.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "vitest run",
		"scan": "node scripts/scan-package.mjs",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ZandoviApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Zandovi/Zandovi.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.55.5",
		"@n8n/scan-community-package": "0.42.0",
		"eslint": "9.32.0",
		"n8n-workflow": "^2.16.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
